{
  "$description": "Colony · Ops Deck design tokens. Source of truth; theme.css and tailwind.config.ts mirror these values.",
  "color": {
    "hud": "#0A0D11",
    "well": "#0B0E12",
    "ground": "#0E1116",
    "surface": "#151A21",
    "raised": "#1C232C",
    "line-soft": "#222A35",
    "line": "#2A333F",
    "line-strong": "#3A4452",
    "ink-dim": "#8592A3",
    "ink-muted": "#A3AEBD",
    "ink-soft": "#C7CFDA",
    "ink": "#E6EAF0",
    "you": "#F0B44C",
    "you-ink": "#1A1405"
  },
  "status": {
    "idle":    { "color": "#8592A3", "glyph": "○", "label": "Idle",            "motion": "none" },
    "think":   { "color": "#A99BF5", "glyph": "⋯", "label": "Thinking",        "motion": "breathe 1.2s" },
    "run":     { "color": "#5AA9F0", "glyph": "›", "label": "Running command", "motion": "link march 1.4s" },
    "edit":    { "color": "#5AA9F0", "glyph": "✎", "label": "Editing files",   "motion": "link march 1.4s" },
    "you":     { "color": "#F5B83D", "glyph": "!", "label": "Waiting on you",  "motion": "attention ring 1.6s" },
    "blocked": { "color": "#C79A5B", "glyph": "⊘", "label": "Blocked",         "motion": "none" },
    "error":   { "color": "#F2706A", "glyph": "✕", "label": "Error",           "motion": "shake ×2 400ms" },
    "paused":  { "color": "#B8C1CC", "glyph": "‖", "label": "Paused",          "motion": "none" },
    "done":    { "color": "#5CC98A", "glyph": "✓", "label": "Done",            "motion": "flash 600ms" }
  },
  "statusBadge": { "fillAlpha": 0.12, "borderAlpha": 0.4 },
  "meterThresholds": { "warn": 70, "critical": 90 },
  "font": {
    "display": "'Chakra Petch', sans-serif",
    "sans": "'IBM Plex Sans', system-ui, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, monospace"
  },
  "type": {
    "display-xl": { "size": "30px", "line": "36px", "weight": 600, "font": "display" },
    "display-lg": { "size": "26px", "line": "32px", "weight": 600, "font": "display" },
    "title":      { "size": "17px", "line": "22px", "weight": 600, "font": "display" },
    "section":    { "size": "15px", "line": "20px", "weight": 600, "font": "display", "case": "upper", "tracking": "0.1em" },
    "numeral":    { "size": "16px", "line": "20px", "weight": 600, "font": "display" },
    "body":       { "size": "14px", "line": "21px", "weight": 400, "font": "sans" },
    "small":      { "size": "12px", "line": "18px", "weight": 400, "font": "sans" },
    "label":      { "size": "10px", "line": "14px", "weight": 500, "font": "sans", "case": "upper", "tracking": "0.12em" },
    "mono":       { "size": "12px", "line": "19px", "weight": 400, "font": "mono" }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px" },
  "radius": { "xs": "4px", "sm": "6px", "md": "8px", "lg": "10px", "xl": "12px", "2xl": "14px", "pill": "999px" },
  "elevation": {
    "e0-well": "none",
    "e1-surface": "none (1px line)",
    "e2-raised": "0 12px 30px rgba(0,0,0,.5)",
    "e3-drawer": "-24px 0 48px rgba(0,0,0,.5)",
    "scrim": "rgba(5,7,10,.62)"
  },
  "motion": {
    "duration": { "instant": "80ms", "fast": "160ms", "base": "240ms", "slow": "400ms", "celebrate": "900ms", "loop-attention": "1600ms", "loop-march": "1400ms" },
    "easing": {
      "standard": "cubic-bezier(.2,.8,.2,1)",
      "enter": "cubic-bezier(0,0,.2,1)",
      "exit": "cubic-bezier(.4,0,1,1)",
      "spring": "cubic-bezier(.34,1.56,.64,1)"
    },
    "stream": { "maxRenderHz": 2, "groupSameKindWithinMs": 1500 }
  }
}
