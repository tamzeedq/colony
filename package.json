{
  "name": "colony",
  "private": true,
  "version": "0.0.1",
  "description": "Run and command teams of Claude Code agents in Docker across your projects.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/start.mjs",
    "stop": "node scripts/stop.mjs",
    "dev:ui": "npm run dev -w @colony/ui",
    "build:ui": "npm run build -w @colony/ui",
    "test:ui": "npm run test:e2e -w @colony/ui",
    "screenshots": "node scripts/screenshots.mjs",
    "agent:image": "npm run build -w @colony/agent-runner && docker build -f docker/agent.Dockerfile -t colony-agent:dev docker",
    "spike:headless": "node spikes/01-headless/run.mjs",
    "dev:cp": "npm run dev -w @colony/control-plane",
    "e2e:agents": "node scripts/e2e-agents.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
